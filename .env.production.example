# ═══════════════════════════════════════════════════════════════════════════════
# Agentic Commerce Platform — Production Environment Variables
# Copy to .env and fill in real values before deployment.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
JWT_SECRET=                           # Strong random secret (≥ 32 chars)
DATABASE_URL=                         # postgresql://user:pass@host:5432/dbname

# DISABLE_AUTH is ignored in production (hardcoded off)
# DISABLE_AUTH=false

# ── CORS / Security ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
RATE_LIMIT_GLOBAL=200                 # Max requests per minute (global)
RATE_LIMIT_PAYMENTS=30                # Max payment executions per minute

# ── OpenAI (chat agent) ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Stripe (legacy payment rail) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── Firecrawl ───────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_X402_ENDPOINT=https://api.firecrawl.dev/v2/x402/search
FIRECRAWL_X402_MAX_PAYMENT=0.10

# ── Firecrawl / Zyte Base Agent Wallet ──────────────────────────────────────
# IMPORTANT: Use a dedicated funded wallet. Never reuse personal keys.
FIRECRAWL_AGENT_PRIVATE_KEY=          # 0x-prefixed hex private key (Base L2)
BASE_RPC_URL=https://mainnet.base.org
USDC_BASE_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ── Zyte ────────────────────────────────────────────────────────────────────
ZYTE_API_KEY=
ZYTE_SCRAPE_COST_USDC=0.01
ZYTE_X402_MAX_PAYMENT=0.10

# ── Solana ──────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_MAINNET=                   # Mainnet RPC endpoint (Helius/Alchemy recommended)
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
ESCROW_PROGRAM_ID=

# Platform Solana payer wallet for trust-gate probes + x402 Solana payments.
# Base58-encoded private key OR JSON array of 64 bytes.
# Generate: node -e "const {Keypair}=require('@solana/web3.js'); const bs58=require('bs58'); const k=Keypair.generate(); console.log(bs58.encode(k.secretKey));"
SOLANA_PAYER_SECRET_KEY=              # base58 private key — keep secret

# ── Wallet Encryption (AES-256-GCM) ─────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=                # 64-char hex, 32 bytes — REQUIRED

# ── x402 execution timeout ───────────────────────────────────────────────────
X402_NATIVE_EXEC_TIMEOUT_MS=120000    # ms; Heurist/Firecrawl scrape can take 60-90 s
