{
  "name": "@agentic-commerce/database",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:migrate": "node-pg-migrate up -m migrations",
    "db:rollback": "node-pg-migrate down -m migrations",
    "db:create": "node-pg-migrate create -m migrations -j js"
  },
  "dependencies": {
    "@agentic-commerce/shared": "*",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
