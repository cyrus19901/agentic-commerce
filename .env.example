# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your-secret-key-change-in-production

# Authentication
# Set to true in development to bypass JWT (use user_email in requests instead)
# Leave unset or false in production
DISABLE_AUTH=false

# Admin user created on first boot (used with DISABLE_AUTH=true)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin

# Database (PostgreSQL)
# Local:   DATABASE_URL=postgresql://postgres:password@localhost:5432/agentic_commerce
# Render:  DATABASE_URL=postgresql://user:pass@dpg-xxx.render.com/agentic_commerce
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentic_commerce

# Etsy API (Optional - uses mock data if not provided)
ETSY_API_KEY=
ETSY_SHOP_ID=

# Stripe (Optional - for real payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Tunneling (for local HTTPS testing with ChatGPT)
# Get ngrok token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# CORS
ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com

# LLM Provider / Proxy (Delphi)
# Use Delphi proxy as OpenAI-compatible endpoint for AI detection/protection.
OPENAI_BASE_URL=https://qrdtfsrrmijoyvcwlyio.supabase.co/functions/v1/ai-proxy
DELPHI_API_KEY=your_delphi_api_key_here

# Optional: model override for chat route
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: direct provider fallback when Delphi returns provider/auth errors.
# If DELPHI_FALLBACK_ENABLED=true and OPENAI_API_KEY is set, the API will
# fallback to direct OpenAI automatically for continuity.
DELPHI_FALLBACK_ENABLED=true
DIRECT_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Firecrawl (web scraping / crawling / interact)
# Get API key from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-dcbf4281af924300af4d474b630f1c5f
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# x402 Facilitator (optional hardening)
# Shared secret for /api/facilitator/verify caller auth
FACILITATOR_SHARED_SECRET=
# Receipt signing (key rotation capable):
# FACILITATOR_RECEIPT_KEYS='{"v1":"secret-one","v2":"secret-two"}'
FACILITATOR_RECEIPT_KEYS=
FACILITATOR_ACTIVE_KID=v1
# Legacy single-key fallback (used if FACILITATOR_RECEIPT_KEYS is unset)
FACILITATOR_RECEIPT_SECRET=

# Funding ledger mode (virtual subaccounts / gift-card model)
# When true, agent-service requests reserve/commit balance from funding_accounts.
USE_FUNDING_LEDGER=false
# Use central treasury wallet as on-chain payer (requires secret key below)
USE_TREASURY_PAYER=false
# Treasury signer secret (choose one format)
TREASURY_SECRET_KEY_JSON=
TREASURY_SECRET_KEY_BASE64=

# Provider-native x402 mode:
# When true, /api/chatgpt-agent/request-service returns the provider's raw x402 challenge
# (payTo/accepts/network/asset) instead of using the internal seller-hop payment path.
PROVIDER_NATIVE_X402=false
# Preferred chain leg to auto-select from provider accepts[] (e.g. solana, base, polygon)
PREFERRED_PROVIDER_NETWORK=solana
# Require explicit user confirmation before treasury executes provider-native payment
REQUIRE_PAYMENT_CONFIRMATION=true

# Mainnet settings for provider-native treasury payments
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com

# On-Chain Escrow Program (Anchor)
# Program ID from the deployed escrow program
ESCROW_PROGRAM_ID=5k5ZZHiar9aheemskLMc54Jx5niwKLmKMNySunsCyj9F
# USDC mint addresses
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT_DEVNET=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr
# Commitment level for on-chain transactions (confirmed | finalized)
SOLANA_COMMITMENT=finalized
# Max retries for failed transactions
SOLANA_MAX_RETRIES=3

# Firecrawl x402 Agent (Base L2)
# The agent maintains a pre-funded Base wallet that pays Firecrawl via x402 per-request.
# When set, crawlPage/searchWeb will use x402 instead of API key.
# Private key (hex, 0x-prefixed) for the agent's Base wallet
FIRECRAWL_AGENT_PRIVATE_KEY=
# x402 endpoints (defaults to Firecrawl's hosted x402 endpoints)
FIRECRAWL_X402_ENDPOINT=https://api.firecrawl.dev/v2/x402/search
FIRECRAWL_X402_SCRAPE_ENDPOINT=https://api.firecrawl.dev/v2/x402/scrape
# Max USDC the agent will pay per request (safety cap)
FIRECRAWL_X402_MAX_PAYMENT=0.10
# Base L2 RPC
BASE_RPC_URL=https://mainnet.base.org
# USDC contract on Base
USDC_BASE_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
